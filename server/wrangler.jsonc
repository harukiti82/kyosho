// 挟将の Worker: 画面（web/ のビルド成果物）とオンライン対戦サーバーを同じオリジンで配信する。
// 画面はルート、API と WebSocket は /api の下。設計と通信仕様は ../.agent/online-protocol.md
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kyosho",
  "main": "src/index.ts",
  // vitest-pool-workers 同梱の workerd が対応する日付以下にする
  "compatibility_date": "2026-08-01",
  "assets": {
    // web の vite build の出力。npm run deploy / dev が先にビルドする
    "directory": "../web/dist",
    // /api だけ Worker を先に通す（protocol.ts の API_PATH と揃える）。
    // それ以外は静的アセットが直接返し、Worker も Durable Object も起こさない
    "run_worker_first": ["/api", "/api/*"],
    // アセットにないパスは Worker に落ち、Worker が 404（テキスト）を返す
    "not_found_handling": "none"
  },
  "durable_objects": {
    // 1 部屋 = 1 Durable Object（部屋 ID から idFromName で引く）。
    // 合言葉の受付は合言葉ごとに 1 つ（正規化した合言葉の SHA-256 から idFromName で引く。src/lobby.ts）。
    // エンドレスマッチは 1 端末 = 1 つ（端末 ID から idFromName。src/endless.ts）と、全員のランキングが 1 つ（名前 "global"。src/ranking.ts）
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "LOBBIES", "class_name": "Lobby" },
      { "name": "ENDLESS", "class_name": "Endless" },
      { "name": "RANKING", "class_name": "Ranking" }
    ]
  },
  // 無料プランで使える SQLite 版の Durable Object
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Lobby"] },
    { "tag": "v3", "new_sqlite_classes": ["Endless", "Ranking"] }
  ],
  "vars": {
    // 同一オリジン（独自ドメイン・workers.dev）からの接続は常に許可する。
    // ここには、それに加えて許可するオリジンをカンマ区切りで書く（末尾 :* は任意のポート）。本番は公開ドメインだけ
    // （同一オリジンの判定でも通るが、公開先として明示する）。ローカル開発の localhost は npm run dev が --var で足す
    "ALLOWED_ORIGINS": "https://kyosho.rukiharukichi.com",
    // エンドレスマッチの機能フラグ。"1" のときだけ /api/endless の下を受け、/api/health に endless: true を返す（画面は入口を出す）。
    // 深く読む CPU が 1 手 約 0.1 秒の CPU を使うので、Workers の有料プランにしてから "1" にする（.agent/online-protocol.md「エンドレスマッチ」）
    "ENDLESS_ENABLED": "0"
  },
  // 独自ドメイン（Custom Domain）: https://kyosho.rukiharukichi.com で配信する。次の本番デプロイで反映され、
  // Cloudflare が DNS レコードと証明書を自動で作る（ゾーン rukiharukichi.com が同じアカウントにあること）。
  // ルートの rukiharukichi.com はほかの用途に空けておくので、ここに足さない
  "routes": [{ "pattern": "kyosho.rukiharukichi.com", "custom_domain": true }],
  // workers.dev の URL（https://kyosho.<アカウント>.workers.dev）でも配信する
  "workers_dev": true
}
