// 挟将のオンライン対戦サーバー（Cloudflare Workers + Durable Objects）。設計と通信仕様は ../.agent/online-protocol.md
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kyosho",
  "main": "src/index.ts",
  // vitest-pool-workers 同梱の workerd が対応する日付以下にする
  "compatibility_date": "2026-08-01",
  "durable_objects": {
    // 1 部屋 = 1 Durable Object（部屋 ID から idFromName で引く）
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  // 無料プランで使える SQLite 版の Durable Object
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "vars": {
    // 接続を許可する画面のオリジン（カンマ区切り。末尾 :* は任意のポート）
    "ALLOWED_ORIGINS": "https://harukiti82.github.io,http://localhost:*,http://127.0.0.1:*"
  }
}
