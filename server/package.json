{
  "name": "kyosho-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:web": "npm --prefix ../web run build",
    "dev": "npm run build:web && wrangler dev --var \"ALLOWED_ORIGINS:http://localhost:*,http://127.0.0.1:*\"",
    "deploy": "npm run build:web && wrangler deploy",
    "deploy:check": "npm run build:web && wrangler deploy --dry-run",
    "types": "wrangler types",
    "pretypecheck": "wrangler types",
    "typecheck": "tsc --noEmit",
    "pretest": "wrangler types",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "typescript": "^7.0.2",
    "vitest": "~4.1.11",
    "wrangler": "^4.147.0"
  }
}
